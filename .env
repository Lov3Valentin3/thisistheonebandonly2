# North Pole Post environment
# Copy these same names into Vercel → Settings → Environment Variables.
# Required. Local Postgres (this sandbox) or your Neon/Supabase URL on a phone deploy.
# Neon example:
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxx.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Public site URL used for SEO, sitemap, and share links.
# After Vercel gives you a domain, change this to https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional. If set, elf letters can use this key. If empty, the workshop still replies with built-in North Pole voices.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini